diff --git a/tests-v2/regressions/buffer-diagnostics.ts b/tests-v2/regressions/buffer-diagnostics.ts
index f6512ea..f7f082c 100644
--- a/tests-v2/regressions/buffer-diagnostics.ts
+++ b/tests-v2/regressions/buffer-diagnostics.ts
@@ -393,3 +393,37 @@ for (const fault of [
     assert.equal(recorder.snapshot().bufferTrend.latest, null)
     assert.equal(recorder.snapshot().counters.bufferTrendRejected, 1)
   })
+for (const rate of [1, 2] as const)
+  test(`diagnostics-cost buffer rows are UTF-8 measured once while capacity stays exact rate=${rate}`, (t) => {
+    const scope = testScope(t)
+    const Encoder = TextEncoder
+    let calls = 0,
+      now = 10000
+    scope.defineGlobal('TextEncoder', {
+      configurable: true,
+      writable: true,
+      value: class extends Encoder {
+        override encode(input?: string) {
+          if (input?.includes('buffer-window-v6')) calls++
+          return super.encode(input)
+        }
+      },
+    })
+    const recorder = new DiagnosticRecorder(
+      () => now,
+      () => false,
+    )
+    for (let i = 0; i < 40; i++) {
+      now += 1000
+      recorder.recordPlayer(sample(now, { ...trend(now), rate }))
+    }
+    assert.ok(calls <= 41, `repeated buffer UTF-8 work: ${calls}`)
+    const before = recorder.snapshot()
+    assert.ok(Buffer.byteLength(JSON.stringify(before.bufferTrend)) <= 8192)
+    assert.ok(Buffer.byteLength(JSON.stringify(before)) <= 128 * 1024)
+    assert.equal(before.counters.bufferTrendEvicted, 40 - before.bufferTrend.history.length)
+    recorder.clear()
+    now += 1000
+    recorder.recordPlayer(sample(now, { ...trend(now), rate }))
+    assert.equal(recorder.snapshot().bufferTrend.history.length, 1)
+  })
