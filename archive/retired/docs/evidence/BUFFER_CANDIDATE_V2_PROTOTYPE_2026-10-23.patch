diff --git a/tests-v2/regressions/buffer-confirmation-domain.ts b/tests-v2/regressions/buffer-confirmation-domain.ts
new file mode 100644
index 0000000..904ac6c
--- /dev/null
+++ b/tests-v2/regressions/buffer-confirmation-domain.ts
@@ -0,0 +1,135 @@
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { confirmBufferTrend } from '../../src-v2/domain/buffer-trend.ts'
+import type {
+  BufferWindowReading,
+  BufferCandidateConfirmation,
+} from '../../src-v2/domain/buffer-trend.ts'
+
+const raw = (rate: number, at: number, buffer: number): BufferWindowReading => ({
+  schemaVersion: 1,
+  algorithm: 'buffer-window-v1',
+  at,
+  from: at - 8000,
+  spanMs: 8000,
+  sampleCount: 9,
+  interpolated: false,
+  progressQuality: 'frames',
+  state: 'draining',
+  reason: 'draining-low',
+  candidate: true,
+  rate,
+  startBufferSec: buffer + 4,
+  endBufferSec: buffer,
+  deltaSec: -4,
+  slopeSecPerSec: -0.5,
+})
+
+for (const rate of [1, 2]) {
+  test(`U-C buffer-v2 confirms only at 1999/2000ms rate=${rate}`, () => {
+    let state = confirmBufferTrend(raw(rate, 10000, 8), null).confirmation
+    state = confirmBufferTrend(raw(rate, 11000, 7.5), state).confirmation
+    const pending = confirmBufferTrend(raw(rate, 11999, 7), state)
+    assert.equal(pending.reading.candidate, false)
+    assert.equal(pending.reading.reason, 'candidate-confirming')
+    const confirmed = confirmBufferTrend(raw(rate, 12000, 6.9), pending.confirmation)
+    assert.equal(confirmed.reading.candidate, true)
+    assert.equal(confirmed.reading.schemaVersion, 2)
+    assert.equal(confirmed.reading.algorithm, 'buffer-window-v2')
+  })
+  test(`U-C buffer-v2 three irregular samples cannot replace elapsed time rate=${rate}`, () => {
+    let state = confirmBufferTrend(raw(rate, 10000, 8), null).confirmation
+    state = confirmBufferTrend(raw(rate, 10999, 7.5), state).confirmation
+    const third = confirmBufferTrend(raw(rate, 11998, 7), state)
+    assert.equal(third.reading.candidate, false)
+    assert.equal(
+      confirmBufferTrend(raw(rate, 12000, 6), third.confirmation).reading.candidate,
+      true,
+    )
+  })
+  for (const confirmed of [false, true])
+    for (const kind of ['refill', 'flat'] as const)
+      test(`U-R buffer-v2 ${kind} revokes confirmed=${confirmed} rate=${rate}`, () => {
+        let state: BufferCandidateConfirmation | null = null
+        for (let i = 0; i < (confirmed ? 3 : 2); i++)
+          state = confirmBufferTrend(raw(rate, 10000 + i * 1000, 8 - i), state).confirmation
+        const at = state!.at + 1000,
+          before = state!.bufferSec
+        const cancelled = confirmBufferTrend(
+          raw(rate, at, kind === 'refill' ? before + 0.000000001 : before),
+          state,
+        )
+        assert.equal(cancelled.reading.candidate, false)
+        assert.equal(
+          cancelled.reading.reason,
+          kind === 'refill' ? 'recent-refill' : 'not-decreasing',
+        )
+        assert.equal(cancelled.confirmation!.since, null)
+        let next = cancelled.confirmation
+        for (let i = 1; i <= 3; i++) {
+          const value = confirmBufferTrend(raw(rate, at + i * 1000, before - i), next)
+          assert.equal(value.reading.candidate, i === 3)
+          next = value.confirmation
+        }
+      })
+  for (const gap of [1500, 1501])
+    test(`U-W buffer-v2 confirmation gap=${gap} rate=${rate}`, () => {
+      const first = confirmBufferTrend(raw(rate, 10000, 8), null)
+      const next = confirmBufferTrend(raw(rate, 10000 + gap, 7), first.confirmation)
+      assert.equal(next.reading.candidate, gap === 1500 ? false : null)
+      if (gap === 1501) {
+        assert.equal(next.confirmation, null)
+        assert.equal(next.reading.reason, 'sample-gap')
+      }
+    })
+  test(`U-W buffer-v2 duplicate time does not change confirmation rate=${rate}`, () => {
+    const first = confirmBufferTrend(raw(rate, 10000, 8), null)
+    const second = confirmBufferTrend(raw(rate, 11000, 7), first.confirmation)
+    const repeated = confirmBufferTrend(raw(rate, 11000, 1), second.confirmation)
+    assert.equal(repeated.reading.candidate, null)
+    assert.equal(repeated.confirmation, second.confirmation)
+    assert.equal(
+      confirmBufferTrend(raw(rate, 12000, 6), repeated.confirmation).reading.candidate,
+      true,
+    )
+  })
+  test(`U-W buffer-v2 time reversal and raw invalidation clear confirmation rate=${rate}`, () => {
+    const first = confirmBufferTrend(raw(rate, 10000, 8), null)
+    assert.equal(
+      confirmBufferTrend(raw(rate, 9999, 7), first.confirmation).reading.reason,
+      'time-reversed',
+    )
+    const empty = confirmBufferTrend(
+      { ...raw(rate, 11000, 7), candidate: null, state: 'insufficient', reason: 'sample-gap' },
+      first.confirmation,
+    )
+    assert.equal(empty.reading.candidate, null)
+    assert.equal(empty.confirmation, null)
+  })
+  for (const field of ['at', 'endBufferSec', 'rate'] as const)
+    for (const invalid of [NaN, Infinity])
+      test(`U-W buffer-v2 rejects ${field}=${String(invalid)} rate=${rate}`, () => {
+        const value = confirmBufferTrend({ ...raw(rate, 10000, 8), [field]: invalid }, null)
+        assert.equal(value.reading.candidate, null)
+        assert.equal(value.confirmation, null)
+      })
+  test(`U-C buffer-v2 raw false restarts rather than resumes confirmation rate=${rate}`, () => {
+    const first = confirmBufferTrend(raw(rate, 10000, 8), null)
+    const clear = confirmBufferTrend(
+      { ...raw(rate, 11000, 7), candidate: false, reason: 'draining-high' },
+      first.confirmation,
+    )
+    const next = confirmBufferTrend(raw(rate, 12000, 6), clear.confirmation)
+    assert.equal(next.reading.candidate, false)
+    assert.equal(next.confirmation!.since, 12000)
+  })
+  test(`U-C buffer-v2 input and returned state are immutable rate=${rate}`, () => {
+    const input = Object.freeze(raw(rate, 10000, 8)),
+      before = structuredClone(input)
+    const result = confirmBufferTrend(input, null)
+    assert.deepEqual(input, before)
+    assert.equal(Object.isFrozen(result.reading), true)
+    assert.equal(Object.isFrozen(result.confirmation), true)
+    assert.equal('rawCandidate' in result.reading, false)
+  })
+}
diff --git a/tests-v2/regressions/buffer-confirmation.ts b/tests-v2/regressions/buffer-confirmation.ts
