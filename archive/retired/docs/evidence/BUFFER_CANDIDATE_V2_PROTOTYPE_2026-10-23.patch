+/** All confirmation state is returned to its sole owner, PlayerMonitor. No clocks or effects. */
+export function confirmBufferTrend(
+  raw: BufferTrendFacts,
+  previous: BufferCandidateConfirmation | null,
+): {
+  readonly reading: BufferTrendReading
+  readonly confirmation: BufferCandidateConfirmation | null
+} {
+  const current: BufferTrendReading = Object.freeze({
+    ...raw,
+    schemaVersion: 2,
+    algorithm: 'buffer-window-v2',
+  })
+  const finish = (reading: BufferTrendReading, confirmation: BufferCandidateConfirmation | null) =>
+    Object.freeze({ reading, confirmation })
+  const validPrevious =
+    previous &&
+    Number.isFinite(previous.at) &&
+    previous.at >= 0 &&
+    Number.isFinite(previous.bufferSec) &&
+    previous.bufferSec >= 0 &&
+    (previous.since === null ||
+      (Number.isFinite(previous.since) && previous.since >= 0 && previous.since <= previous.at))
