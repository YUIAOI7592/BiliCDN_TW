@@ -0,0 +1,111 @@
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { runScenario } from '../support/buffer-shadow-scenarios.ts'
+import { bufferMonitor } from '../support/buffer-monitor.ts'
+import { epochId, generationId, representationId } from '../../src-v2/domain/model.ts'
+
+for (const rate of [1, 2] as const) {
+  for (const name of ['jitter-2s', 'burst-refill', 'low-sawtooth'] as const)
+    test(
+      `buffer-v2 integration ${name} suppresses short candidates rate=${rate}`,
+      { timeout: 5000 },
+      async (t) => {
+        const result = await runScenario(name, rate, t)
+        assert.equal(result.score.episodes.length, 0)
+        assert.equal(result.score.candidateMs, 0)
+        assert.equal(result.cleanup.timers, 0)
+        assert.equal(result.cleanup.subscriptions, 0)
+      },
+    )
+  test(
+    `buffer-v2 integration refill revokes at first increasing sample rate=${rate}`,
+    { timeout: 5000 },
+    async (t) => {
+      const result = await runScenario('drain-refill', rate, t)
+      assert.deepEqual(
+        result.score.episodes.map((e) => [e.start, e.end]),
+        [[6000, 9000]],
+      )
+      assert.equal(result.score.candidateMs, 3000)
+      assert.equal(result.score.episodes[0]!.followup, 'continued')
+    },
+  )
+  for (const [name, first, lead] of [
+    ['slow-exhaustion', 22000, 18000],
+    ['fast-exhaustion', 3000, 3000],
+  ] as const)
+    test(
+      `buffer-v2 integration ${name} preserves useful lead rate=${rate}`,
+      { timeout: 5000 },
+      async (t) => {
+        const result = await runScenario(name, rate, t)
+        assert.equal(result.score.episodes[0]!.start, first)
+        assert.equal(result.score.firstLeadMs, lead)
+      },
+    )
+}
+
+for (const rate of [1, 2])
+  for (const confirmed of [false, true])
+    for (const field of [
+      'mediaId',
+      'coreId',
+      'seekRevision',
+      'userRevision',
+      'reloadRevision',
+      'coreReloadRevision',
+      'epoch',
+      'generation',
+      'representation',
+      'policy',
+      'authority',
+      'host',
+      'rate',
+      'reset',
+      'stop',
+      'dispose',
+    ] as const)
+      test(`buffer-v2 Monitor ${field} clears confirmed=${confirmed} rate=${rate}`, (t) => {
+        const f = bufferMonitor(t, rate)
+        f.monitor.tick()
+        for (let i = 0; i < 60; i++) f.step(12)
+        f.step(11)
+        f.step(10)
+        if (confirmed) {
+          f.step(9)
+          f.step(8)
+        }
+        assert.equal(f.monitor.snapshot().bufferTrend!.candidate, confirmed)
+        if (field === 'epoch') f.state.epoch = epochId(2)
+        else if (field === 'generation') f.state.generation = generationId(2)
+        else if (field === 'representation')
+          f.changeRequest({ representation: representationId('new') })
+        else if (field === 'policy') f.changeRequest({ routePolicyRevision: 2 })
+        else if (field === 'authority') f.changeRequest({ authorityRevision: 2 })
+        else if (field === 'host')
+          f.changeRequest({ targetHost: 'upos-sz-mirrorali.bilivideo.com' })
