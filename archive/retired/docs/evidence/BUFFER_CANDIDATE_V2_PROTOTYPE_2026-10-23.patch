+    return finish(emptyBufferTrend(raw.at!, 'warming-up'), validPrevious)
+  if (raw.candidate === null) return finish(current, null)
+  if (
+    raw.at === null ||
+    !Number.isFinite(raw.at) ||
+    raw.at < 0 ||
+    raw.endBufferSec === null ||
+    !Number.isFinite(raw.endBufferSec) ||
+    raw.endBufferSec < 0 ||
+    raw.rate === null ||
+    !Number.isFinite(raw.rate) ||
+    raw.rate <= 0
+  )
+    return finish(emptyBufferTrend(raw.at ?? NaN, 'invalid-sample'), null)
+  if (validPrevious && (raw.at < validPrevious.at || raw.at - validPrevious.at > 1500))
+    return finish(
+      emptyBufferTrend(raw.at, raw.at < validPrevious.at ? 'time-reversed' : 'sample-gap'),
+      null,
+    )
+  const next = (since: number | null) =>
+    Object.freeze({ at: raw.at!, bufferSec: raw.endBufferSec!, since })
+  if (!raw.candidate) return finish(current, next(null))
+  if (validPrevious && raw.endBufferSec >= validPrevious.bufferSec)
+    return finish(
+      Object.freeze({
+        ...current,
+        candidate: false,
+        reason: raw.endBufferSec > validPrevious.bufferSec ? 'recent-refill' : 'not-decreasing',
+      }),
+      next(null),
+    )
+  const since = validPrevious?.since ?? raw.at,
+    confirmed = raw.at - since >= 2000
+  return finish(
+    Object.freeze({
+      ...current,
+      candidate: confirmed,
+      reason: confirmed ? 'draining-low' : 'candidate-confirming',
+    }),
